#!/usr/bin/env bash
# Trim target/ without forcing a full rebuild.
#
#   script/prune-target [--builds N] [--keep N] [--dry-run]
#
# A "build" is a burst of reads in deps/: rustc reads every dependency's
# rlib/rmeta when compiling, and APFS updates atime on read. Reads separated by
# more than $gap_seconds start a new build. Everything not read since the start
# of the --builds most recent builds is dropped.
#
# 1. deps/, build/, .fingerprint/: drop artifacts not read since that cutoff.
# 2. incremental/: rustc never deletes caches for old crate hashes (feature
#    sets, profiles, toolchains). Per crate name keep the --keep most recently
#    used caches and drop the rest. No cutoff here: a cache is only read when
#    its crate is recompiled, so the last build may not have touched it.

set -euo pipefail

builds=1
keep=2
dry_run=0
# rustc may compile or link one large crate for many minutes without reading
# any other file, so the gap must be longer than that.
gap_seconds=1800
while [[ $# -gt 0 ]]; do
    case "$1" in
        --builds) builds="$2"; shift 2 ;;
        --keep) keep="$2"; shift 2 ;;
        --dry-run) dry_run=1; shift ;;
        *) echo "unknown argument: $1" >&2; exit 1 ;;
    esac
done

if ! [[ "$builds" =~ ^[1-9][0-9]*$ ]]; then
    echo "--builds must be a positive integer" >&2
    exit 1
fi

target_dir="${CARGO_TARGET_DIR:-$(cd "$(dirname "$0")/.." && pwd)/target}"

if pgrep -qx cargo || pgrep -qx rustc; then
    echo "cargo/rustc is running; refusing to prune" >&2
    exit 1
fi

freed_kb=0
remove() {
    local size
    size=$(du -sk "$1" | cut -f1)
    freed_kb=$((freed_kb + size))
    if [[ $dry_run -eq 1 ]]; then
        echo "would remove $1"
    else
        rm -rf "$1"
    fi
}

for profile_dir in "$target_dir"/*/; do
    profile_dir="${profile_dir%/}"
    [[ -d "$profile_dir/deps" ]] || continue

    # Access time where the $builds-th most recent build started.
    cutoff=$(
        find "$profile_dir/deps" -maxdepth 1 -type f -exec stat -f '%a' {} + \
            | sort -rn \
            | awk -v builds="$builds" -v gap="$gap_seconds" '
                NR == 1 { count = 1 }
                NR > 1 && previous - $1 > gap { if (++count > builds) exit }
                { start = $1; previous = $1 }
                END { print start }
            '
    )
    [[ -n "$cutoff" ]] || continue

    if [[ -d "$profile_dir/incremental" ]]; then
        # Newest first, so the first $keep entries per crate name survive.
        while IFS= read -r path; do
            remove "$path"
        done < <(
            ls -1td "$profile_dir"/incremental/*/ 2>/dev/null \
                | sed 's#/$##' \
                | awk -F/ -v keep="$keep" '{
                    name = $NF; sub(/-[^-]+$/, "", name)
                    if (++seen[name] > keep) print
                }'
        )
    fi

    while IFS= read -r path; do
        remove "$path"
    done < <(
        find "$profile_dir/deps" -maxdepth 1 -type f -exec stat -f '%a %N' {} + \
            | awk -v cutoff="$cutoff" '$1 < cutoff { sub(/^[0-9]+ /, ""); print }'
    )

    for dir in build .fingerprint; do
        [[ -d "$profile_dir/$dir" ]] || continue
        while IFS= read -r path; do
            # A directory counts as used if any file inside was read since the cutoff.
            newest=$(find "$path" -type f -exec stat -f '%a' {} + | sort -rn | head -1)
            if [[ -z "$newest" || "$newest" -lt "$cutoff" ]]; then
                remove "$path"
            fi
        done < <(find "$profile_dir/$dir" -mindepth 1 -maxdepth 1 -type d)
    done
done

label=$([[ $dry_run -eq 1 ]] && echo "Would free" || echo "Freed")
echo "$label $((freed_kb / 1024)) MB from $target_dir"
